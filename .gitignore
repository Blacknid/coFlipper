# Cheia API nu are ce sa caute in depozit: repozitoriul e public.
# Sablonul fara cheie se afla in desktop/.env.example.

.env
*.env
!*.env.example

__pycache__/
*.pyc
.venv/
venv/
dist/

# Memoria persistenta a agentului: date de rulare, specifice utilizatorului.
desktop/memory.json
desktop/memory.tmp

# Generated by ufbt when building the Flipper application.
flipper/.vscode/
compile_commands.json

# The app builder's default store lives in ~/.coflipper (outside the repo). If
# COFLIPPER_APP_STORE is pointed at a path inside the repo, the generated apps and their
# build trees should not be committed.
.coflipper/
apps_store/
.ufbt/
